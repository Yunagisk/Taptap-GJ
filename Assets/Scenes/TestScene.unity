      m_Calls: []
  m_text: "00 Intro\r\n\u610F\u5927\u5229\u7537\u5B50\r\n\u201C\u8BDD\u8BF4\u57FA\u7763\u964D\u4E16\u4E4B\u540E\u8FC7\u4E86\u7855\u679C\u7D2F\u7D2F\u7684\u4E00\u5343\u4E09\u767E\u56DB\u5341\u516B\u5E74\uFF0C\u610F\u5927\u5229\u6700\u7F8E\u4E3D\u7684\u57CE\u5E02\uFF0C\u51FA\u7C7B\u62D4\u8403\u7684\u4F5B\u7F57\u4F26\u8428\uFF0C\u7ADF\u53D1\u751F\u4E86\u4E00\u573A\u8981\u547D\u7684\u761F\u75AB\u3002\u201D\r\n\u52A8\u542C\u7684\u58F0\u97F3\uFF08\u8272\u6B32\uFF09\r\n\u4F55\u5FC5\u8FD9\u4E48\u8BA4\u771F\u2026\u2026\u7EB5\u60C5\u73A9\u7B11\u624D\u662F\u5BF9\u4ED8\u75AB\u75C5\u7684\u7075\u4E39\u5999\u65B9\uFF0C\u4E0D\u662F\u4E48\uFF1F\r\n\u6211\u4EEC\u4E0D\u7528\u987E\u5FCC\u4EC0\u4E48\u3002\r\n\u56DE\u5E94\u8272\u6B32\r\n\u73A9\u5BB6\u9009\u9879\t\u5BF9\u5E94\u53CD\u9988\r\n\u201C\u867D\u7136\u4F60\u542C\u8D77\u6765\u9B45\u529B\u5341\u8DB3\uFF0C\u4F46\u761F\u75AB\u662F\u5F88\u4E25\u8083\u7684\u4E8B\u60C5\u3002\u201D\t\u4F60\u8BA4\u4E3A\u5373\u4F7F\u65E0\u6CD5\u5E72\u9884\u5176\u4ED6\u4EBA\u7684\u505A\u6D3E\uFF0C\u4F46\u81F3\u5C11\u5173\u8D77\u95E8\u6765\u4E0E\u4E16\u9694\u7EDD\uFF0C\u5C31\u8FD9\u6837\u751F\u6D3B\u4E0B\u53BB\u8FD8\u662F*\u6CA1\u6709*\u95EE\u9898\u3002\uFF08\u4F60\u9996\u5148\u72AF\u4E0B\u7684\u662F\u50B2\u6162\u4E4B\u7F6A\u3002\uFF09\r\n\u201C\u4F60\u8BF4\u4EC0\u4E48\uFF1F\u8BF7\u518D\u8BF4\u4E00\u904D\u3002\u201D\t\u8FD9\u4E2A\u7684\u58F0\u97F3\u72EC\u4E00\u65E0\u4E8C\uFF0C\u542C\u8D77\u6765\u603B\u6709\u4E00\u79CD\u5947\u602A\u7684\u5438\u5F15\u529B\u3002\u4F60\u5FCD\u4E0D\u4F4F\u60F3\u8BA9*\u7942*\u591A\u53D1\u51FA\u70B9\u52A8\u9759\u3002\r\n\u662F\u7684\uFF0C\u4E0D\u7BA1\u662F\u7528\u4EC0\u4E48\u65B9\u5F0F\u3002\r\n\u610F\u5927\u5229\u7537\u5B50\r\n\u201C
    \u4E0D\u77E5\u662F\u7531\u4E8E\u5929\u4F53\u661F\u8FB0\u7684\u5F71\u54CD\uFF0C\u8FD8\u662F\u56E0\u4E3A\u6211\u4EEC\u591A\u884C\u4E0D\u4E49\uFF0C\u5929\u4E3B\u5927\u53D1\u96F7\u9706\uFF0C\u964D\u7F5A\u4E8E\u4E16\u4EBA\uFF0C\u90A3\u573A\u761F\u75AB\u51E0\u5E74\u524D\u5148\u5728\u4E1C\u65B9\u5730\u533A\u5F00\u59CB\uFF0C\u593A\u53BB\u4E86\u65E0\u6570\u751F\u7075\u6027\u547D\uFF0C\u7136\u540E\u6BEB\u4E0D\u505C\u7559\uFF0C\u4EE5\u71CE\u539F\u4E4B\u52E2\u5411\u897F\u65B9\u7EE7\u7EED\u8513\u5EF6\u3002\u201D\r\n\u6D51\u6D4A\u7684\u58F0\u97F3\uFF08\u66B4\u98DF\uFF09\r\n\u7EB5\u996E\u72C2\u6B22\u5427\uFF01\u6211\u77A7\u89C1\u6B7B\u795E\u5728\u4EB2\u543B\u4F60\u7684\u989D\u89D2\u4E86\u5B69\u5B50\u2026\u2026\r\n\u6101\u7709\u82E6\u8138\u8981\u8FCE\u63A5\u957F\u7720\uFF0C\u5F00\u6000\u5403\u559D\u3001\u5927\u5FEB\u6735\u9890\u4E5F\u8981\u8FCE\u6765\u957F\u7720\u3002\u4E0D\u8981\u505A\u524D\u8005\u90A3\u6837\u7684\u50BB\u74DC\u2026.\r\n\u542B\u6DF7\u7684\u58F0\u97F3\uFF08\u8D2A\u5A6A\uFF09\r\n\u7269\u5C3D\u5176\u7528\u2026\u8FD9\u4E9B\u4E1C\u897F\u5B64\u96F6\u96F6\u7684\u8EBA\u5728\u8FD9\u91CC\u592A\u6D6A\u8D39\u4E86\u3002\u4F60\u89C1\u5230\u7684\u662F\u98CE\u9669\uFF0C\u6211\u89C1\u5230\u7684\u662F\u2026.\u7EDD\u597D\u7684\u673A\u4F1A\u3002\r\n\u56DE\u5E94\u8D2A\u5A6A\r\n\u73A9\u5BB6\u9009\u9879\t\u5BF9\u5E94\u53CD\u9988\r\n\u201C\u673A\u4F1A\uFF1F\u8BF4\u8BF4\u770B\u3002\u201D\t\u4E71\u4E16\u51FA\u82F1\u96C4\uFF0C\u4F60\u5C06\u662F\u90A3\u4E2A\u82F1\u96C4\u3002\u867D\u7136\u6211\u4EEC\u7684\u82F1\u96C4\u76EE\u524D\u6709\u70B9\u6F66\u5012\u3002\u5443\uFF0C\u6211\u60F3\u5F3A\u8C03\u7684\u5176\u5B9E\u662F*\u7A77\u56F0*\u3002\r\n\u201C\u662F\u554A\uFF0C\u5403\u4EC0\u4E48\uFF1F\u201D\t\u662F\u554A\uFF0C\u5403\u4EC0\u4E48\u3002\r\n\u610F\u5927\u5229\u7537\u5B50\r\n\u2026\u2026.\r\n\u610F\u5927\u5229\u7537\u5B50\r\n\u201C\u6211\u4EEC\u7684\u57CE\u5E02\u9677\u4EBA\u5982\u6B64\u6DF1\u91CD\u7684\u82E6\u96BE\u548C\u56F0\u6270\uFF0C\u4EE5\u81F3\u4EE4\u4EBA\u656C\u754F\u7684\u6CD5\u5F8B\u548C\u5929\u6761\u7684\u6743\u5A01\u5F00\u59CB\u571F\u5D29\u74E6\u89E3\u3002\u201D\r\n\u610F\u5927\u5229\u7537\u5B50\r\n\u2026\u2026.\r\n\u610F\u5927\u5229\u7537\u5B50\r\n\u201C\u5509\uFF0C\u6709\u591A\u5C11\u5DCD\u5CE8\u7684\u5BAB\u6BBF\u3001\u8C6A\u534E\u7684\u90B8\u5B85\u3001\u6F02\u4EAE\u7684\u623F\u5C4B\u4EE5\u524D\u4EBA\u4E01\u5174\u65FA\uFF0C\u571F\u7EC5\u548C\u8D35\u5987\u6D4E\u6D4E\u4E00\u5802\uFF0C\u5982\u4ECA\u8FDE\u7528\u4EBA\u90FD\u6B7B\u5149\u6B7B\u7EDD\uFF0C\u4E00\u4E2A\u4E0D\u5269!
    \u6709\u591A\u5C11\u663E\u8D6B\u7684\u95E8\u7B2C\u3001\u8457\u540D\u7684\u4EA7\u4E1A\u3001\u5E9E\u5927\u7684\u8D22\u5BCC\u7559\u4E0B\u6765\u6CA1\u6709\u6CD5\u5B9A\u7684\u7EE7\u627F\u4EBA!
    \u591A\u5C11\u52C7\u6562\u7684\u7537\u5B50\u3001\u5982\u82B1\u4F3C\u7389\u7684\u7F8E\u4EBA\u3001\u5934\u89D2\u5CE5\u5D58\u7684\u9752\u5E74\uFF0C\u5C31\u8FDE\u52A0\u5170\u8BFA\u3001\u5E0C\u6CE2\u514B\u62C9\u5E95\u548C\u57C3\u65AF\u5E93\u62C9\u5E87\u4E4C\u65AF\u4E5F\u4F1A\u8BA4\u4E3A\u662F\u5065\u58EE\u7684
