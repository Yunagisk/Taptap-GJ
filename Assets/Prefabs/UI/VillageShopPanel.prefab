  offers:
  - id: sword
    consumable: 0
    artwork: {fileID: 21300000, guid: a4167196019243d1b98832e06fe386a4, type: 3}
    artworkUv:
      serializedVersion: 2
      x: 0.43115234
      y: 0.24365234
      width: 0.18847656
      height: 0.5527344
    description: "\u8F7B\u5DE7\u7684\u76F4\u5251\uFF0C\u950B\u5229\u7684\u5251\u5C16\u9002\u5408\u7CBE\u51C6\u7A7F\u523A\u3002"
  - id: axe
    consumable: 0
    artwork: {fileID: 21300000, guid: 6c0b7a5c01ce4127a68707282e79a185, type: 3}
    artworkUv:
      serializedVersion: 2
      x: 0.43603516
      y: 0.29101562
      width: 0.1303711
      height: 0.5234375
    description: "\u539A\u91CD\u7684\u65A7\u5203\u6A2A\u5411\u6325\u780D\uFF0C\u80FD\u540C\u65F6\u5288\u5411\u9762\u524D\u7684\u654C\u4EBA\u3002"
  - id: hammer
    consumable: 0
    artwork: {fileID: 21300000, guid: 898d754bf8cf41f598a5dd19a1069256, type: 3}
    artworkUv:
      serializedVersion: 2
      x: 0.4243164
      y: 0.23535156
      width: 0.18164062
      height: 0.578125
    description: "\u6C89\u5B9E\u7684\u94C1\u9524\u4EE5\u949D\u51FB\u7838\u788E\u654C\u4EBA\u7684\u62A4\u7532\u3002"
  - id: torch
    consumable: 0
    artwork: {fileID: 21300000, guid: fa8ba6adb805b774694741b7b41e6ded, type: 3}
    artworkUv:
      serializedVersion: 2
      x: 0.48486328
      y: 0.3564453
      width: 0.092285156
      height: 0.46875
    description: "\u6447\u66F3\u7684\u706B\u7130\u707C\u70E7\u654C\u4EBA\uFF0C\u7559\u4E0B\u6301\u7EED\u71C3\u70E7\u7684\u4F59\u70EC\u3002"
  - id: greatsword
    consumable: 0
    artwork: {fileID: 21300000, guid: 23e37b1c529018a498430e86cd9637b7, type: 3}
    artworkUv:
      serializedVersion: 2
      x: 0.40234375
      y: 0.13134766
      width: 0.19628906
      height: 0.7363281
    description: "\u6C89\u91CD\u7684\u53CC\u624B\u5927\u5251\uFF0C\u4EE5\u5F3A\u529B\u6325\u780D\u538B\u57AE\u654C\u4EBA\u7684\u9632\u7EBF\u3002"
  - id: spear
    consumable: 0
    artwork: {fileID: 21300000, guid: 886fda18d1e34b06b158c0dcaf9a65b3, type: 3}
    artworkUv:
      serializedVersion: 2
      x: 0.47998047
      y: 0.09082031
      width: 0.07763672
      height: 0.8144531
    description: "\u4FEE\u957F\u7684\u77DB\u5C16\u76F4\u6307\u8981\u5BB3\uFF0C\u523A\u4E2D\u5F31\u70B9\u65F6\u66F4\u6613\u51FB\u6E83\u654C\u4EBA\u3002"
  - id: sickle
    consumable: 0
    artwork: {fileID: 21300000, guid: c1cc9da1dd73d0048bec3a361fd7a1ac, type: 3}
    artworkUv:
      serializedVersion: 2
      x: 0.32080078
      y: 0.09765625
      width: 0.3569336
      height: 0.8046875
    description: "\u5F2F\u66F2\u7684\u9570\u5203\u8FDE\u7EED\u6536\u5272\uFF0C\u5BF9\u7834\u9632\u7684\u654C\u4EBA\u5C24\u4E3A\u81F4\u547D\u3002"
  - id: flail
