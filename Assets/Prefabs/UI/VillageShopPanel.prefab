    artworkUv:
      serializedVersion: 2
      x: 0.31982422
      y: 0.23779297
      width: 0.35986328
      height: 0.52441406
    description: "\u94C1\u94FE\u7275\u52A8\u6C89\u91CD\u9524\u5934\uFF0C\u5728\u8FDE\u51FB\u4E2D\u524A\u5F31\u654C\u4EBA\u7684\u529B\u91CF\u3002"
