    speaker: "\u610F\u5927\u5229\u7537\u5B50"
    content: "\u201C\u8BDD\u8BF4\u57FA\u7763\u964D\u4E16\u4E4B\u540E\u8FC7\u4E86\u7855\u679C\u7D2F\u7D2F\u7684\u4E00\u5343\u4E09\u767E\u56DB\u5341\u516B\u5E74\uFF0C\u610F\u5927\u5229\u6700\u7F8E\u4E3D\u7684\u57CE\u5E02\uFF0C\u51FA\u7C7B\u62D4\u8403\u7684\u4F5B\u7F57\u4F26\u8428\uFF0C\u7ADF\u53D1\u751F\u4E86\u4E00\u573A\u8981\u547D\u7684\u761F\u75AB\u3002\u201D"
    avatar: {fileID: 21300000, guid: 3205e2bcb6be15b4697739f4c6893465, type: 3}
    choices: []
    nextNodeID: node01
  nodes:
  - id: node01
    speaker: "\u8272\u6B32"
    content: "\u4F55\u5FC5\u8FD9\u4E48\u8BA4\u771F\u2026\u2026\u7EB5\u60C5\u73A9\u7B11\u624D\u662F\u5BF9\u4ED8\u75AB\u75C5\u7684\u7075\u4E39\u5999\u65B9\uFF0C\u4E0D\u662F\u4E48\uFF1F\r\n\u6211\u4EEC\u4E0D\u7528\u987E\u5FCC\u4EC0\u4E48\u3002\r\n"
    avatar: {fileID: 0}
    choices:
    - choiceText: "\u201C\u867D\u7136\u4F60\u542C\u8D77\u6765\u9B45\u529B\u5341\u8DB3\uFF0C\u4F46\u761F\u75AB\u662F\u5F88\u4E25\u8083\u7684\u4E8B\u60C5\u3002\u201D"
      targetNodeID: node01A
    - choiceText: "\u201C\u4F60\u8BF4\u4EC0\u4E48\uFF1F\u8BF7\u518D\u8BF4\u4E00\u904D\u3002\u201D"
      targetNodeID: node01B
    nextNodeID: 
  - id: node01A
    speaker: '1:'
    content: "\u4F60\u8BA4\u4E3A\u5373\u4F7F\u65E0\u6CD5\u5E72\u9884\u5176\u4ED6\u4EBA\u7684\u505A\u6D3E\uFF0C\u4F46\u81F3\u5C11\u5173\u8D77\u95E8\u6765\u4E0E\u4E16\u9694\u7EDD\uFF0C\u5C31\u8FD9\u6837\u751F\u6D3B\u4E0B\u53BB\u8FD8\u662F*\u6CA1\u6709*\u95EE\u9898\u3002\uFF08\u4F60\u9996\u5148\u72AF\u4E0B\u7684\u662F\u50B2\u6162\u4E4B\u7F6A\u3002\uFF09"
    avatar: {fileID: 0}
    choices: []
    nextNodeID: 
  - id: node01B
    speaker: '2:'
    content: "\u8FD9\u4E2A\u7684\u58F0\u97F3\u72EC\u4E00\u65E0\u4E8C\uFF0C\u542C\u8D77\u6765\u603B\u6709\u4E00\u79CD\u5947\u602A\u7684\u5438\u5F15\u529B\u3002\u4F60\u5FCD\u4E0D\u4F4F\u60F3\u8BA9*\u7942*\u591A\u53D1\u51FA\u70B9\u52A8\u9759\u3002\r\n\u662F\u7684\uFF0C\u4E0D\u7BA1\u662F\u7528\u4EC0\u4E48\u65B9\u5F0F\u3002\r\n"
