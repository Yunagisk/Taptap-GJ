  nodes:
  - id: node01
    speaker: "\u8272\u6B32"
    content: "\u4F55\u5FC5\u8FD9\u4E48\u8BA4\u771F\u2026\u2026\u7EB5\u60C5\u73A9\u7B11\u624D\u662F\u5BF9\u4ED8\u75AB\u75C5\u7684\u7075\u4E39\u5999\u65B9\uFF0C\u4E0D\u662F\u4E48\uFF1F\r\n\u6211\u4EEC\u4E0D\u7528\u987E\u5FCC\u4EC0\u4E48\u3002\r\n"
    avatar: {fileID: 0}
    choices:
    - choiceText: "\u201C\u867D\u7136\u4F60\u542C\u8D77\u6765\u9B45\u529B\u5341\u8DB3\uFF0C\u4F46\u761F\u75AB\u662F\u5F88\u4E25\u8083\u7684\u4E8B\u60C5\u3002\u201D"
      targetNodeID: node01A
    - choiceText: "\u201C\u4F60\u8BF4\u4EC0\u4E48\uFF1F\u8BF7\u518D\u8BF4\u4E00\u904D\u3002\u201D"
      targetNodeID: node01B
    nextNodeID: 
  - id: node01A
    speaker: "\u4F60:"
    content: "\u4F60\u8BA4\u4E3A\u5373\u4F7F\u65E0\u6CD5\u5E72\u9884\u5176\u4ED6\u4EBA\u7684\u505A\u6D3E\uFF0C\u4F46\u81F3\u5C11\u5173\u8D77\u95E8\u6765\u4E0E\u4E16\u9694\u7EDD\uFF0C\u5C31\u8FD9\u6837\u751F\u6D3B\u4E0B\u53BB\u8FD8\u662F*\u6CA1\u6709*\u95EE\u9898\u3002\uFF08\u4F60\u9996\u5148\u72AF\u4E0B\u7684\u662F\u50B2\u6162\u4E4B\u7F6A\u3002\uFF09"
    avatar: {fileID: 0}
    choices: []
    nextNodeID: node02
  - id: node01B
    speaker: "\u4F60:"
    content: "\u8FD9\u4E2A\u7684\u58F0\u97F3\u72EC\u4E00\u65E0\u4E8C\uFF0C\u542C\u8D77\u6765\u603B\u6709\u4E00\u79CD\u5947\u602A\u7684\u5438\u5F15\u529B\u3002\u4F60\u5FCD\u4E0D\u4F4F\u60F3\u8BA9*\u7942*\u591A\u53D1\u51FA\u70B9\u52A8\u9759\u3002\r\n\u662F\u7684\uFF0C\u4E0D\u7BA1\u662F\u7528\u4EC0\u4E48\u65B9\u5F0F\u3002\r\n"
    avatar: {fileID: 0}
    choices: []
    nextNodeID: node02
  - id: node02
    speaker: "\u610F\u5927\u5229\u7537\u5B50"
    content: "\u201C \u4E0D\u77E5\u662F\u7531\u4E8E\u5929\u4F53\u661F\u8FB0\u7684\u5F71\u54CD\uFF0C\u8FD8\u662F\u56E0\u4E3A\u6211\u4EEC\u591A\u884C\u4E0D\u4E49\uFF0C\u5929\u4E3B\u5927\u53D1\u96F7\u9706\uFF0C\u964D\u7F5A\u4E8E\u4E16\u4EBA\uFF0C\u90A3\u573A\u761F\u75AB\u51E0\u5E74\u524D\u5148\u5728\u4E1C\u65B9\u5730\u533A\u5F00\u59CB\uFF0C\u593A\u53BB\u4E86\u65E0\u6570\u751F\u7075\u6027\u547D\uFF0C\u7136\u540E\u6BEB\u4E0D\u505C\u7559\uFF0C\u4EE5\u71CE\u539F\u4E4B\u52E2\u5411\u897F\u65B9\u7EE7\u7EED\u8513\u5EF6\u3002\u201D"
    avatar: {fileID: 0}
    choices: []
    nextNodeID: node03
  - id: node03
    speaker: "\u66B4\u98DF"
    content: "\u7EB5\u996E\u72C2\u6B22\u5427\uFF01\u6211\u77A7\u89C1\u6B7B\u795E\u5728\u4EB2\u543B\u4F60\u7684\u989D\u89D2\u4E86\u5B69\u5B50\u2026\u2026\n\u6101\u7709\u82E6\u8138\u8981\u8FCE\u63A5\u957F\u7720\uFF0C\u5F00\u6000\u5403\u559D\u3001\u5927\u5FEB\u6735\u9890\u4E5F\u8981\u8FCE\u6765\u957F\u7720\u3002\u4E0D\u8981\u505A\u524D\u8005\u90A3\u6837\u7684\u50BB\u74DC\u2026."
    avatar: {fileID: 0}
    choices: []
    nextNodeID: node04
  - id: node04
    speaker: "\u8D2A\u5A6A"
    content: "\u7269\u5C3D\u5176\u7528\u2026\u8FD9\u4E9B\u4E1C\u897F\u5B64\u96F6\u96F6\u7684\u8EBA\u5728\u8FD9\u91CC\u592A\u6D6A\u8D39\u4E86\u3002\u4F60\u89C1\u5230\u7684\u662F\u98CE\u9669\uFF0C\u6211\u89C1\u5230\u7684\u662F\u2026.\u7EDD\u597D\u7684\u673A\u4F1A\u3002"
