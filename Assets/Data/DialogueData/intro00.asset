    speaker: "\u610F\u5927\u5229\u7537\u5B50"
    content: "\u201C\u8BDD\u8BF4\u57FA\u7763\u964D\u4E16\u4E4B\u540E\u8FC7\u4E86\u7855\u679C\u7D2F\u7D2F\u7684\u4E00\u5343\u4E09\u767E\u56DB\u5341\u516B\u5E74\uFF0C\n\u610F\u5927\u5229\u6700\u7F8E\u4E3D\u7684\u57CE\u5E02\uFF0C\u51FA\u7C7B\u62D4\u8403\u7684\u4F5B\u7F57\u4F26\u8428\uFF0C\u7ADF\u53D1\u751F\u4E86\u4E00\u573A\u8981\u547D\u7684\u761F\u75AB\u3002\u201D"
