  m_Script: {fileID: 11500000, guid: 9a2bc6bb0af034d488226177bbd540eb, type: 3}
  m_Name: VillageIntroArrival
  m_EditorClassIdentifier: 
  dialogueId: intro_village_arrival
  completionEffect: 0
  startNode:
    id: arrival_start
    speaker: "旁白"
    lineKind: 1
    content: "这座城市在你眼前摊开，像一桌吃到一半就被人掀翻的宴席，宾客散尽便只有苍蝇和死亡还留在餐桌上忘情痛饮。"
    avatar: {fileID: 0}
    isProtagonist: 0
    choices: []
    nextNodeID: arrival_windows
  nodes:
  - id: arrival_windows
    speaker: "旁白"
    lineKind: 1
    content: "这个地方的待客方式多少有点特别。你一路经过三扇窗户，三扇窗户都在你靠近时“砰”地关上。"
    avatar: {fileID: 0}
    isProtagonist: 0
    choices: []
    nextNodeID: arrival_fourth_window
  - id: arrival_fourth_window
    speaker: "旁白"
    lineKind: 1
    content: "第四扇窗户——它原本就关着，显然准备得更充分。"
    avatar: {fileID: 0}
    isProtagonist: 0
    choices: []
