  - id: hand
    speaker: "旁白"
    lineKind: 1
    content: "加斯帕拿起你的右手，翻过来看看你的掌心又样了样你的肩膀。"
    guideReward: 0
    avatar: {fileID: 0}
    isProtagonist: 0
    choices: []
    nextNodeID: recommend
  - id: recommend
